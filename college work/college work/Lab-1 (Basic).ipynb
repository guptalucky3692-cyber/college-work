# Area of a Rectangle and Triangle
# Predefined Version
length = 10
width = 5
base = 8
height = 4
print("Rectangle area =", length * width)
print("Triangle area =", 0.5 * base * height)
# User-Defined Version
length = float(input("Enter rectangle length: "))
width = float(input("Enter rectangle width: "))
base = float(input("Enter triangle base: "))
height = float(input("Enter triangle height: "))
print("Rectangle area =", length * width)
print("Triangle area =", 0.5 * base * height)

# Swap Two Numbers
# Predefined Version
a = 10
b = 20
a, b = b, a
print("a =", a)
print("b =", b)

# User-Defined Version
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
a, b = b, a
print("a =", a)
print("b =", b)

# Square and Cube of a Number
# Predefined Version
n = 4
print("Square =", n ** 2)
print("Cube =", n ** 3)

# User-Defined Version
n = float(input("Enter a number: "))
print("Square =", n ** 2)
print("Cube =", n ** 3)

# Celsius to Fahrenheit
# Predefined Version
c = 25
f = (c * 9/5) + 32
print("Fahrenheit =", f)
# User-Defined Version
c = float(input("Enter temperature in Celsius: "))
f = (c * 9/5) + 32
print("Fahrenheit =", f)

# Check Even or Odd
# Predefined Version
n = 10

if n % 2 == 0:
    print("Even")
else:
    print("Odd")

# User-Defined Version
n = int(input("Enter a number: "))
if n % 2 == 0:
    print("Even")
else:
    print("Odd")
    
# Check Positive, Negative or Zero
# Predefined Version
n = -5

if n > 0:
    print("Positive")
else:
    if n < 0:
        print("Negative")
    else:
        print("Zero")
        
# User-Defined Version
n = int(input("Enter a number: "))

if n > 0:
    print("Positive")
else:
    if n < 0:
        print("Negative")
    else:
        print("Zero")
        
# Largest of Two Numbers
# Predefined Version
a = 25
b = 18
if a > b:
        print("Largest =", a)
else:
    if b > a:
        print("Largest =", b)
    else:
        print("Both are equal")
        
# User Defined Version
a = float(input("Enter first number: "))
b = float(input("Enter second number: "))

if a > b:
    print("Largest =", a)
else:
    if b > a:
        print("Largest =", b)
    else:
        print("Both are equal")